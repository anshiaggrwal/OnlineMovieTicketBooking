@model OnlineMovieTicketBooking.ViewModels.TheatreVM

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>TheatreVM</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="TheatreId" />

            <div class="form-group">
                <label asp-for="TheaName" class="control-label"></label>
                <input asp-for="TheaName" class="form-control" />
                <span asp-validation-for="TheaName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TheaAddress" class="control-label"></label>
                <input asp-for="TheaAddress" class="form-control" />
                <span asp-validation-for="TheaAddress" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TheaCIty" class="control-label"></label>
                <input asp-for="TheaCIty" class="form-control" />
                <span asp-validation-for="TheaCIty" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="TheaIsActive" class="control-label"></label>
                <input asp-for="TheaIsActive" class="form-check-input" />
                <span asp-validation-for="TheaIsActive" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}