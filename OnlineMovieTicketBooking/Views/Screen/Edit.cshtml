@model OnlineMovieTicketBooking.ViewModels.ScreenVM

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit Screen</h1>

<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="ScreenId" />
            <input type="hidden" asp-for="TheatreId" />

            <div class="form-group">
                <label class="control-label">Theatre</label>
                <input value="@Model.Theatre?.TheaName" class="form-control" readonly />
            </div>

            <div class="form-group">
                <label asp-for="ScreenName" class="control-label"></label>
                <input asp-for="ScreenName" class="form-control" />
                <span asp-validation-for="ScreenName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="RegularSeats" class="control-label"></label>
                <input asp-for="RegularSeats" class="form-control" readonly />
            </div>

            <div class="form-group">
                <label asp-for="PremiumSeats" class="control-label"></label>
                <input asp-for="PremiumSeats" class="form-control" readonly />
            </div>

            <div class="form-group">
                <label asp-for="ReclinerSeats" class="control-label"></label>
                <input asp-for="ReclinerSeats" class="form-control" readonly />
            </div>

            <div class="form-group">
                <label asp-for="TotalSeats" class="control-label"></label>
                <input asp-for="TotalSeats" class="form-control" readonly />
            </div>

            <div class="form-group">
                <label asp-for="ScreenIsActive" class="control-label"></label>
                <input asp-for="ScreenIsActive" class="form-check-input" />
                <span asp-validation-for="ScreenIsActive" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}