@model OnlineMovieTicketBooking.ViewModels.ScreenVM

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete Screen</h1>

<h3>Are you sure you want to delete this?</h3>

<div>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            Theatre
        </dt>
        <dd class="col-sm-10">
            @Model.Theatre?.TheaName
        </dd>

        <dt class="col-sm-2">
            Screen Name
        </dt>
        <dd class="col-sm-10">
            @Model.ScreenName
        </dd>

        <dt class="col-sm-2">
            Regular Seats
        </dt>
        <dd class="col-sm-10">
            @Model.RegularSeats
        </dd>

        <dt class="col-sm-2">
            Premium Seats
        </dt>
        <dd class="col-sm-10">
            @Model.PremiumSeats
        </dd>

        <dt class="col-sm-2">
            Recliner Seats
        </dt>
        <dd class="col-sm-10">
            @Model.ReclinerSeats
        </dd>

        <dt class="col-sm-2">
            Total Seats
        </dt>
        <dd class="col-sm-10">
            @Model.TotalSeats
        </dd>

        <dt class="col-sm-2">
            Active
        </dt>
        <dd class="col-sm-10">
            @Model.ScreenIsActive
        </dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="ScreenId" />
        <input type="submit" value="Delete" class="btn btn-danger" />
        <a asp-action="Index">Back to List</a>
    </form>
</div>