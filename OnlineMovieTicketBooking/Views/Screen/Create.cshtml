@model OnlineMovieTicketBooking.ViewModels.ScreenVM

@{
    ViewData["Title"] = "Create";
}

<h1>Create Screen</h1>

<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="TheatreId" class="control-label"></label>
                <select asp-for="TheatreId" class="form-control" asp-items="ViewBag.TheatreId">
                    <option value="">Select Theatre</option>
                </select>
                <span asp-validation-for="TheatreId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ScreenName" class="control-label"></label>
                <input asp-for="ScreenName" class="form-control" />
                <span asp-validation-for="ScreenName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="RegularSeats" class="control-label"></label>
                <input asp-for="RegularSeats" class="form-control" />
                <span asp-validation-for="RegularSeats" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PremiumSeats" class="control-label"></label>
                <input asp-for="PremiumSeats" class="form-control" />
                <span asp-validation-for="PremiumSeats" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ReclinerSeats" class="control-label"></label>
                <input asp-for="ReclinerSeats" class="form-control" />
                <span asp-validation-for="ReclinerSeats" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ScreenIsActive" class="control-label"></label>
                <input asp-for="ScreenIsActive" class="form-check-input" />
                <span asp-validation-for="ScreenIsActive" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}