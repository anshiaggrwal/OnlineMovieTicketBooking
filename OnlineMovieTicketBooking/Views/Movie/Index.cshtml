@model IEnumerable<OnlineMovieTicketBooking.ViewModels.MovieVM>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

@if (User.IsInRole("Admin"))
{
    <p>
        <a asp-action="Create">Create New</a>
    </p>
}

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.MovTitle)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MovDescription)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MovGenre)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MovLanguage)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MovDuration)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MovRelDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MovPosterUrl)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MovIsActive)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.MovTitle)
                </td>
                <td>
                    @Html.DisplayFor(model => item.MovDescription)
                </td>
                <td>
                    @Html.DisplayFor(model => item.MovGenre)
                </td>
                <td>
                    @Html.DisplayFor(model => item.MovLanguage)
                </td>
                <td>
                    @Html.DisplayFor(model => item.MovDuration)
                </td>
                <td>
                    @Html.DisplayFor(model => item.MovRelDate)
                </td>
                <td>
                    @Html.DisplayFor(model => item.MovPosterUrl)
                </td>
                <td>
                    @Html.DisplayFor(model => item.MovIsActive)
                </td>
                <td>
                    <a asp-action="Details" asp-route-id="@item.MovieId">Details</a>

                    @if (User.IsInRole("Admin"))
                    {
                        <span> | </span>
                        <a asp-action="Edit" asp-route-id="@item.MovieId">Edit</a>
                        <span> | </span>
                        <a asp-action="Delete" asp-route-id="@item.MovieId">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>