@model List<OnlineMovieTicketBooking.Models.BookingModel>

<h2>My Bookings</h2>

@if (Model.Count == 0)
{
    <p>You have no bookings.</p>
}
else
{
    <table>
        <thead>
            <tr>
                <th>Booking Reference</th>
                <th>Movie</th>
                <th>Date</th>
                <th>Time</th>
                <th>Total Amount</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>

        <tbody>
            @foreach (var booking in Model)
            {
                <tr>
                    <td>@booking.BookingReference</td>
                    <td>@booking.ShowSchedule?.Movie?.MovTitle</td>
                    <td>@booking.ShowSchedule?.ShowDate</td>
                    <td>@booking.ShowSchedule?.ShowStartTime</td>
                    <td>₹@booking.TotalAmount</td>
                    <td>@booking.BookingStatus</td>
                    <td>
                        <a asp-action="Details"
                           asp-route-bookingId="@booking.BookingId">
                            Details
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}