@model OnlineMovieTicketBooking.Models.BookingModel

<h2>Booking Details</h2>

<div>
    <p>Booking Reference: @Model.BookingReference</p>

    <p>Movie: @Model.ShowSchedule?.Movie?.MovTitle</p>

    <p>Screen: @Model.ShowSchedule?.Screen?.ScreenName</p>

    <p>Date: @Model.ShowSchedule?.ShowDate</p>

    <p>Time: @Model.ShowSchedule?.ShowStartTime - @Model.ShowSchedule?.ShowEndTime</p>

    <p>Booking Date: @Model.BookingDate</p>

    <p>Status: @Model.BookingStatus</p>

    <h4>Seats</h4>

    @if (Model.BookingSeats != null)
    {
        @foreach (var seat in Model.BookingSeats)
        {
            <p>
                @seat.Seat?.RowNum@seat.Seat?.SeatNum
                - @seat.Price
            </p>
        }
    }

    <p>Total Amount: ₹@Model.TotalAmount</p>
</div>