@model List<OnlineMovieTicketBooking.ViewModels.SeatVM>

@{
    var show = ViewBag.Show as OnlineMovieTicketBooking.Models.ShowScheduleModel;
}

<h2>Select Seats</h2>

<div>
    <h4>@show.Movie?.MovTitle</h4>
    <p>Date: @show.ShowDate</p>
    <p>Time: @show.ShowStartTime - @show.ShowEndTime</p>
    <p>Screen: @show.Screen?.ScreenName</p>
</div>

<form asp-action="Create" method="post">

    <input type="hidden" name="ShowScheduleId" value="@show.ShowScheduleId" />
    <h4>Seat Prices</h4>

    @if (show.ShowSeatPrices != null)
    {
        <p>
            Regular: ₹@show.ShowSeatPrices.FirstOrDefault(x => x.SeatType == OnlineMovieTicketBooking.Models.SeatType.Regular)?.ShowSeatPrice
            &nbsp;&nbsp;
            Premium: ₹@show.ShowSeatPrices.FirstOrDefault(x => x.SeatType == OnlineMovieTicketBooking.Models.SeatType.Premium)?.ShowSeatPrice
            &nbsp;&nbsp;
            Recliner: ₹@show.ShowSeatPrices.FirstOrDefault(x => x.SeatType == OnlineMovieTicketBooking.Models.SeatType.Recliner)?.ShowSeatPrice
        </p>
    }
    <h4>Select Seats</h4>

    @foreach (var row in Model.GroupBy(x => x.RowNum))
    {
        <div>
            <strong>Row @row.Key</strong>

            @foreach (var seat in row.OrderBy(x => x.SeatNum))
            {
                <label>
                    @if (seat.IsBooked)
                    {
                        <input type="checkbox" disabled />
                    }
                    else
                    {
                        <input type="checkbox"
                               name="SeatIds"
                               value="@seat.SeatId" />
                    }

                    @seat.RowNum@seat.SeatNum
                </label>
            }
        </div>
    }

    <br />

    <button type="submit">Continue to Payment</button>

    <div asp-validation-summary="All"></div>

</form>