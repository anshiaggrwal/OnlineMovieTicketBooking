@model OnlineMovieTicketBooking.ViewModels.ShowScheduleVM

@{
    ViewData["Title"] = "Create";
}

<h1>Create Show Schedule</h1>

<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="MovieId" class="control-label"></label>
                <select asp-for="MovieId" class="form-control" asp-items="ViewBag.Movies">
                    <option value="">Select Movie</option>
                </select>
                <span asp-validation-for="MovieId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ScreenId" class="control-label"></label>
                <select asp-for="ScreenId" class="form-control" asp-items="ViewBag.Screens">
                    <option value="">Select Screen</option>
                </select>
                <span asp-validation-for="ScreenId" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ShowDate" class="control-label"></label>
                <input asp-for="ShowDate" class="form-control" />
                <span asp-validation-for="ShowDate" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ShowStartTime" class="control-label"></label>
                <input asp-for="ShowStartTime" class="form-control" />
                <span asp-validation-for="ShowStartTime" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="RegularPrice" class="control-label"></label>
                <input asp-for="RegularPrice" class="form-control" />
                <span asp-validation-for="RegularPrice" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="PremiumPrice" class="control-label"></label>
                <input asp-for="PremiumPrice" class="form-control" />
                <span asp-validation-for="PremiumPrice" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ReclinerPrice" class="control-label"></label>
                <input asp-for="ReclinerPrice" class="form-control" />
                <span asp-validation-for="ReclinerPrice" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ShowIsActive" class="control-label"></label>
                <input asp-for="ShowIsActive" class="form-check-input" />
                <span asp-validation-for="ShowIsActive" class="text-danger"></span>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}