@model OnlineMovieTicketBooking.ViewModels.ShowScheduleVM

@{
    ViewData["Title"] = "Details";
}

<h1>Show Details</h1>

<div>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Movie</dt>
        <dd class="col-sm-10">@Model.Movie?.MovTitle</dd>

        <dt class="col-sm-2">Screen</dt>
        <dd class="col-sm-10">@Model.Screen?.ScreenName</dd>

        <dt class="col-sm-2">Show Date</dt>
        <dd class="col-sm-10">@Model.ShowDate</dd>

        <dt class="col-sm-2">Start Time</dt>
        <dd class="col-sm-10">@Model.ShowStartTime</dd>

        <dt class="col-sm-2">End Time</dt>
        <dd class="col-sm-10">@Model.ShowEndTime</dd>

        <dt class="col-sm-2">Regular Price</dt>
        <dd class="col-sm-10">₹@Model.RegularPrice</dd>

        <dt class="col-sm-2">Premium Price</dt>
        <dd class="col-sm-10">₹@Model.PremiumPrice</dd>

        <dt class="col-sm-2">Recliner Price</dt>
        <dd class="col-sm-10">₹@Model.ReclinerPrice</dd>

        <dt class="col-sm-2">Active</dt>
        <dd class="col-sm-10">@Model.ShowIsActive</dd>
    </dl>
</div>

<div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Edit" asp-route-id="@Model.ShowScheduleId">Edit</a>
        <span> | </span>
    }
    <a asp-controller="Booking"
       asp-action="SelectSeats"
       asp-route-showScheduleId="@Model.ShowScheduleId">
        Book Now
    </a>

    <span> | </span>

    <a asp-action="Index">Back to List</a>
</div>