@model List<OnlineMovieTicketBooking.Models.MovieModel>

@{
    ViewData["Title"] = "Home Page";
}

<h1>Movies</h1>

@if (Model.Count == 0)
{
    <p>No movies available.</p>
}
else
{
    @foreach (var movie in Model)
    {
        <div>
            <h2>@movie.MovTitle</h2>

            @if (!string.IsNullOrEmpty(movie.MovPosterUrl))
            {
                <img src="@movie.MovPosterUrl" alt="@movie.MovTitle" width="200" />
            }

            <p>@movie.MovDescription</p>
            <p>Genre: @movie.MovGenre</p>
            <p>Language: @movie.MovLanguage</p>
            <p>Duration: @movie.MovDuration minutes</p>

            <h4>Available Shows</h4>

            @if (movie.ShowSchedules != null && movie.ShowSchedules.Any(x => x.ShowIsActive))
            {
                @foreach (var show in movie.ShowSchedules.Where(x => x.ShowIsActive))
                {
                    <div>
                        <p>
                            Theatre: @show.Screen?.Theatre?.TheaName
                        </p>

                        <p>
                            Screen: @show.Screen?.ScreenName
                        </p>

                        <p>
                            Date: @show.ShowDate
                        </p>

                        <p>
                            Time: @show.ShowStartTime - @show.ShowEndTime
                        </p>

                        <a asp-controller="Booking"
                           asp-action="SelectSeats"
                           asp-route-showScheduleId="@show.ShowScheduleId">
                            Book Now
                        </a>
                    </div>

                    <hr />
                }
            }
            else
            {
                <p>No shows available.</p>
            }

            <hr />
        </div>
    }
}